# Пример окружения без секретов. Пустые поля заполняются при запуске и в git не попадают.
# Заглушка password у Postgres — не секрет. Токены бота и ключ GitHub App остаются пустыми.
# GitHub App → Webhook URL = PUBLIC_WEBHOOK_ORIGIN + /github/webhook, секрет — GITHUB_WEBHOOK_SECRET.
# Бот этот адрес в GitHub не записывает.

DATABASE_URL=postgres://user:password@postgres:5432/progress
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=progress
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PORT=8080
HOST=0.0.0.0
SCHEDULER_INTERVAL_MS=60000
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
PUBLIC_WEBHOOK_ORIGIN=https://bot.example.com
PUBLIC_HOST=bot.example.com
