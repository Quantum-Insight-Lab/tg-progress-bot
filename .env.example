# Скопируйте в .env. Файл .env в git не попадает.
# Имена совпадают со схемой src/config. Пустое необязательное поле можно не задавать.

# Обязательно. Строка подключения PostgreSQL.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/progress_bot

# Токен бота от BotFather.
TELEGRAM_BOT_TOKEN=

# GitHub App: числовой id.
GITHUB_APP_ID=

# Приватный ключ App одной строкой, переносы как \n.
GITHUB_APP_PRIVATE_KEY=

# Секрет подписи webhook GitHub.
GITHUB_WEBHOOK_SECRET=
