# Скопируйте в .env. Файл .env в git не попадает.
# Имена совпадают со схемой src/config. Пустое необязательное поле можно не задавать.
#
# Это файл для npm test, не для живого бота.
# Живой бот читает /etc/progress-bot/env и базу progress_bot.
# Здесь база progress_bot_test, чтобы тесты не писали в живую.

# Обязательно. Строка подключения PostgreSQL для тестов.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/progress_bot_test

# Токен бота от BotFather.
TELEGRAM_BOT_TOKEN=

# GitHub App: числовой id.
GITHUB_APP_ID=

# Приватный ключ App одной строкой, переносы как \n.
GITHUB_APP_PRIVATE_KEY=

# Секрет подписи webhook GitHub.
GITHUB_WEBHOOK_SECRET=

# Порт HTTP.
PORT=8080
