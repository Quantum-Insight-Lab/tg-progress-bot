{
  "name": "tg-progress-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "boundaries": "depcruise src --config dependency-cruiser.config.mjs",
    "test": "vitest run --testTimeout=15000",
    "codegen:events": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/codegen-events.ts",
    "check:invariants": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-invariants.ts",
    "check:mechanisms": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-mechanisms.ts",
    "knip": "knip",
    "tz:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/tz-check.ts",
    "tz:trace": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/tz-check.ts --trace",
    "backlog:publish": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/backlog-publish.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/migrate-main.ts",
    "register-webhooks": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/register-webhooks-main.ts",
    "ci": "npm run typecheck && npm run lint && npm run boundaries && npm run codegen:events -- --check && npm run check:invariants -- --strict && npm run check:mechanisms && npm run knip && npm test && npm run tz:check -- --gate --pda"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "knip": "^5.88.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "kysely": "^0.29.6",
    "octokit": "^5.0.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
