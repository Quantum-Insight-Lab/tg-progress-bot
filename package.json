{
  "name": "tg-progress-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "boundaries": "depcruise src --config dependency-cruiser.config.mjs",
    "codegen:events": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/codegen-events.ts",
    "check:generated": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-generated-events.ts",
    "ci": "npm run lint && npm run build && npm run boundaries && npm run check:generated && npm test"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "grammy": "^1.36.3",
    "kysely": "^0.28.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3",
    "yaml": "^2.9.1"
  }
}
